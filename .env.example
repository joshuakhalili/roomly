# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — never commit real keys.

# ── Supabase ────────────────────────────────────────────────────────────────
# Found in your Supabase project: Settings → API

# Safe to expose to the browser. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# SECRET. Bypasses every Row Level Security rule in the database.
# Server-side only — never referenced in client components, never logged,
# never pasted anywhere public. Used only to create admin accounts and to
# run the scheduled cron jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Cron protection ─────────────────────────────────────────────────────────
# Any long random string. Vercel Cron sends this so the daily job route
# can't be triggered by anyone who guesses the URL.
# Generate one with:  openssl rand -base64 32
CRON_SECRET=generate-a-long-random-string

# ── App URL ─────────────────────────────────────────────────────────────────
# Used to build absolute links (e.g. the calendar subscription URL).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Login abuse protection (OPTIONAL, recommended for public trials) ───────
# Cloudflare Turnstile is free. The secret is validated only on the server.
# Set both values together; leaving both blank disables the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional extra check, e.g. roomly.vercel.app (no protocol).
TURNSTILE_EXPECTED_HOSTNAME=

# Optional dedicated HMAC secret for the database-backed login throttle.
# If blank, CRON_SECRET (then the service-role key) is used server-side.
LOGIN_RATE_LIMIT_SECRET=

# ── Email digest (OPTIONAL) ─────────────────────────────────────────────────
# Only needed if you want the daily email summary of alerts.
# Leave blank to disable — the app works fine without it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
