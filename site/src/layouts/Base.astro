---
import "@fontsource-variable/instrument-sans";
import "../styles/site.css";
import { login, contact, repository } from "../data/links";
interface Props {
  title: string;
  description?: string;
  hero?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = "Roomly brings properties, people, rent, maintenance and home records together. Property management, with room for living.",
  hero = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/images/shared-home.jpg", Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class:list={[{ "has-hero": hero }]}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="Roomly home">
        <svg viewBox="0 0 32 32" aria-hidden="true">
          <path
            d="M4 5h5v22H4Z M9 9a18 18 0 0 1 18 18h-5A13 13 0 0 0 9 14V9Z"
            fill="currentColor"
          />
        </svg>
        roomly.
      </a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/#features">The product</a>
        <a href="/#pricing">Plans</a>
        <a href="/blog">Field notes</a>
        <a href="/contact-us">Our approach</a>
      </nav>
      <div class="header-actions">
        <a class="login-link" href={login}>
          Log in <span aria-hidden="true">↗</span>
        </a>
        <a class="button compact" href={contact}>
          Request access <span aria-hidden="true">↗</span>
        </a>
      </div>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="/#features">The product</a>
          <a href="/#pricing">Plans</a>
          <a href="/blog">Field notes</a>
          <a href="/contact-us">Our approach</a>
          <a href={login}>Log in</a>
          <a href={contact}>Request access</a>
        </nav>
      </details>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a class="brand" href="/">
          roomly.
        </a>
        <p>
          A little more organised.
          <br />A lot more at home.
        </p>
        <a class="text-link" href={contact}>
          Let’s talk Roomly <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Roomly</span>
        <nav aria-label="Footer">
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms-of-use">Terms</a>
          <a href="/changelog">Updates</a>
          <a href={repository}>
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
        <span>Made for the everyday.</span>
      </div>
    </footer>
    <script>
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reduce && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          el.classList.add("reveal-ready");
          observer.observe(el);
        });
      }
      document
        .querySelectorAll(".mobile-menu a")
        .forEach((link) =>
          link.addEventListener("click", () =>
            document.querySelector(".mobile-menu")?.removeAttribute("open"),
          ),
        );
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          const menu =
            document.querySelector<HTMLDetailsElement>(".mobile-menu");
          if (menu?.open) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
          }
        }
      });
    </script>
  </body>
</html>
