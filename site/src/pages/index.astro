---
import Base from "../layouts/Base.astro";
import { contact } from "../data/links";
const features = [
  [
    "01",
    "Know every room.",
    "Properties, people and tenancies in one connected view. See who’s arriving, who’s leaving and what needs your attention.",
    "Properties & tenancies",
  ],
  [
    "02",
    "Keep the numbers straight.",
    "Rent schedules that follow the tenancy. Expenses, maintenance costs and utility bills brought together by UK tax year.",
    "Rent & expenses",
  ],
  [
    "03",
    "Remember the details.",
    "Dated condition photos, check-in and check-out comparisons, private documents and clear maintenance records.",
    "Inventory & maintenance",
  ],
];
const faqs = [
  [
    "Who is Roomly for?",
    "Roomly is built for people managing shared houses, HMOs, studios, flats and short-stay rooms. Properties, individual units and their tenancies stay connected.",
  ],
  [
    "Can more than one person manage a property?",
    "Yes. Organisation roles let owners, administrators and staff work together, with a separate read-only viewer role.",
  ],
  [
    "Which languages can I use?",
    "The management app supports English, Simplified Chinese and Turkish. You can switch language from the app navigation.",
  ],
  [
    "Does Roomly collect rent?",
    "Roomly tracks due dates and recorded payments. Payment collection stays with the bank or payment service you already use.",
  ],
  [
    "Can I use it on my phone?",
    "Yes. Roomly works in your browser on desktop and mobile, and can be added to your phone’s home screen.",
  ],
  [
    "How do I get access?",
    "Use Request access to get in touch. If you already have an account, choose Log in.",
  ],
];
---

<Base title="Roomly — Room for living." hero>
  <section class="hero" aria-labelledby="hero-title">
    <img
      class="hero-photo"
      src="/images/shared-home.jpg"
      alt="Friends spending time together in a bright shared kitchen"
      width="2200"
      height="1467"
      fetchpriority="high"
    />
    <div class="hero-content">
      <p class="eyebrow">For the homes you look after.</p>
      <div class="hero-wordmark" aria-hidden="true">
        roomly.
      </div>
      <h1 id="hero-title">
        Good homes.
        <br />
        More headspace.
      </h1>
      <p class="hero-description">
        Keep the running of a home in order.
        <br />
        Leave more room for the people in it.
      </p>
      <a class="button light" href={contact}>
        Request access <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="hero-foot">
      <span>Property management. A little more human.</span>
      <a href="#features">
        Take a look <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section class="intro section-pad" id="features" data-reveal>
    <div>
      <p class="eyebrow">The details, taken care of.</p>
      <h2>
        Behind every good home,
        <br />a thousand little things.
      </h2>
    </div>
    <p class="lede">
      The rent that’s due. The key handover. The boiler that needs a look.
      Roomly brings it all together, so you can get on with looking after
      people.
    </p>
  </section>
  <section class="product section-pad" data-reveal>
    <div class="product-heading">
      <span class="eyebrow">Your everyday, in one place</span>
      <span>01 / The workspace</span>
    </div>
    <div class="screen-frame">
      <img
        src="/images/dashboard.png"
        alt="Roomly dashboard showing rent, occupancy, rooms and upcoming work"
        width="2880"
        height="1800"
        loading="lazy"
      />
    </div>
    <div class="feature-rows">
      {features.map(([number, title, body, label]) => (
        <div class="feature-row">
          <span class="feature-number">{number}</span>
          <h3>
            {title}
            <small>{label}</small>
          </h3>
          <p>{body}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="human-story">
    <div class="story-image">
      <img
        src="/images/shared-kitchen.jpg"
        alt="Two people making a meal together at home"
        width="2200"
        height="1467"
        loading="lazy"
      />
    </div>
    <div class="story-copy" data-reveal>
      <p class="eyebrow">A home is more than a record.</p>
      <h2>
        Less chasing.
        <br />
        More living.
      </h2>
      <p>
        Clear records make the everyday easier. From a well-prepared move-in to
        the repair that gets remembered, the small things add up to a better
        place to live.
      </p>
      <a class="text-link" href="/contact-us">
        The thinking behind Roomly <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="detail section-pad" data-reveal>
    <div class="section-heading">
      <div>
        <p class="eyebrow">From the first key to the last check.</p>
        <h2>
          A little detail.
          <br />A big difference.
        </h2>
      </div>
      <p>Keep the story of a room together, through every stay.</p>
    </div>
    <div class="two-features">
      <article>
        <div class="screen-frame small">
          <img
            src="/images/inventory.png"
            alt="Roomly inventory with structured condition and cleanliness records"
            width="2880"
            height="1800"
            loading="lazy"
          />
        </div>
        <h3>Give every handover a clear record.</h3>
        <p>
          Photographs, condition ratings and side-by-side comparisons. Export a
          PDF when it’s time to share.
        </p>
      </article>
      <article>
        <div class="screen-frame small">
          <img
            src="/images/maintenance.png"
            alt="Roomly maintenance schedule for property jobs"
            width="2880"
            height="1800"
            loading="lazy"
          />
        </div>
        <h3>Keep the next job in sight.</h3>
        <p>
          Plan repairs, organise recurring work and keep contractor, asset and
          cost details close to the job.
        </p>
      </article>
    </div>
  </section>
  <section class="documents section-pad" data-reveal>
    <div>
      <p class="eyebrow">Made for UK lettings.</p>
      <h2>
        The paperwork.
        <br />
        In its place.
      </h2>
      <p>
        Keep property certificates and tenancy documents organised, with expiry
        dates and a clear view of missing records.
      </p>
      <a
        class="text-link"
        href="https://www.gov.uk/private-renting/your-landlords-safety-responsibilities"
      >
        Read the government guidance <span aria-hidden="true">↗</span>
      </a>
    </div>
    <ul class="document-list">
      <li>
        <span>Gas safety records</span>
        <span>01</span>
      </li>
      <li>
        <span>Electrical safety reports</span>
        <span>02</span>
      </li>
      <li>
        <span>Energy performance certificates</span>
        <span>03</span>
      </li>
      <li>
        <span>Licences & tenancy documents</span>
        <span>04</span>
      </li>
    </ul>
  </section>
  <section class="faq section-pad" data-reveal>
    <div>
      <p class="eyebrow">A few useful answers.</p>
      <h2>
        Before you
        <br />
        come on in.
      </h2>
    </div>
    <div>
      {faqs.map(([question, answer]) => (
        <details>
          <summary>
            {question}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>
  <section class="final-cta section-pad">
    <p class="eyebrow">Make space for what matters.</p>
    <h2>
      There’s room
      <br />
      for better.
    </h2>
    <a class="button light" href={contact}>
      Request access <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
